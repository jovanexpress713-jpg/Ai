{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "verify": "node scripts/verify-workspace.mjs",
    "lint": "tsc --noEmit",
    "test": "node scripts/security-tests.mjs && tsx scripts/auth-policy-tests.ts && tsx scripts/sandbox-policy-tests.ts && node scripts/ui-contract-tests.mjs && tsx scripts/provider-config-tests.ts && tsx scripts/provider-adapter-tests.ts && tsx scripts/provider-router-tests.ts",
    "smoke": "node scripts/runtime-smoke.mjs",
    "check": "npm run lint && npm run test && npm run smoke && npm run build"
  },
  "dependencies": {
    "@google/genai": "2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "0.546.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "vite": "8.3.0",
    "express": "4.21.2",
    "dotenv": "17.2.3",
    "motion": "12.23.24",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "@types/express": "4.17.21"
  }
}
